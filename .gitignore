# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env — never commit real keys
.env
.env.local
.env.*
!.env.example
*.key
*.pem

# Claude Code local settings — command allowlist embeds the service_role key
.claude/settings.local.json
.claude/

# Sensitive tutoring transcripts — contain student personal utterances
# (schema.sql:126 flags this corpus as 민감자산). The app reads it from Supabase
# (teacher_chunks); the repo keeps only migrate_to_pgvector.py, not the raw data.
provided/episodes.jsonl
provided/subchunks.jsonl

# Supabase CLI 로컬 상태 — 링크된 프로젝트 ref·조직 id·풀러 URL 등 머신 로컬 값.
# `supabase link` 가 재생성하므로 버전관리 대상이 아니다.
supabase/.temp/
supabase/.branches/

# Python — 평가 스크립트 / api 포트
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# 평가 파이프라인 산출물 (재생성 가능, 응답 원문 포함 가능)
responses.jsonl
judge_scores.csv
human_codes.csv
/eval_out/

# e2e 스크린샷
.e2e-artifacts/


# Copy to api/.env and fill in. NEVER commit api/.env (see repo .gitignore: .env.*).
# Only names are listed here — no real values.

# Supabase (public values, same project as the Edge functions).
# Used ONLY to validate the caller's JWT via GoTrue (read-only, no DB writes).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# LLM provider switch — mirrors the Edge function.
#   openai  (default): gpt-4o-mini via api.openai.com,  key = OPENAI_API_KEY
#   gateway          : claude-sonnet-5 via 서강대 게이트웨이, key = GATEWAY_API_KEY
LLM_PROVIDER=openai
OPENAI_API_KEY=
GATEWAY_API_KEY=
